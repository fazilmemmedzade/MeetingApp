@model MeetingInfo
@{
    ViewBag.Title = "Görüş Ərizəsi";
    Layout = "_Layout2";
}
<main class="text-center">
    <h1 class="h4">@ViewData["Salamlama"]</h1>
    <p>Zəhmət olmasa, görüşdə iştirak statusunuzu qeyd edin.</p>
    <div class="card my-2">
        <ul class="list-group list-group-flush">
            <li class="list-group-item">@Model.Location</li>
            <li class="list-group-item">Görüş @Model.Date.ToString("dd/MM/yyyy HH:mm:ss") tarixində baş tutacaq.</li>
            <li class="list-group-item">@Model.NumberOfPeople Katılımcı</li>
        </ul>
    </div>
    <a class="btn btn-sm btn-outline-primary" asp-controller="meeting" asp-action="apply">Müraciət edin</a>
</main>